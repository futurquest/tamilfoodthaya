[Unit]
Description=Tamil Food Thaya encrypted PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tftbackup
Group=tftbackup
WorkingDirectory=/opt/tamilfoodthaya/server
EnvironmentFile=/etc/tamilfoodthaya/backup.env
ExecStart=/usr/bin/npm run db:backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tamilfoodthaya

